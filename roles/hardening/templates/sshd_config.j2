# Global SSHD configuration
Port 22

# Authentication (disabled passwords for everyone by default)
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no

# Security & Session
PermitRootLogin prohibit-password
UsePAM {{ 'no' if ansible_facts['os_family'] == 'Alpine' else 'yes' }}
X11Forwarding no
PrintMotd no

# Subsystem SFTP (OS-specific path)
{% if ansible_facts['os_family'] == 'FreeBSD' %}
Subsystem sftp /usr/libexec/sftp-server
{% elif ansible_facts['os_family'] == 'Alpine' %}
Subsystem sftp /usr/lib/ssh/sftp-server
{% elif ansible_facts['os_family'] in ['RedHat', 'ROSA'] %}
Subsystem sftp /usr/libexec/openssh/sftp-server
{% else %}
Subsystem sftp /usr/lib/openssh/sftp-server
{% endif %}

# Allow password authentication ONLY for root
Match User root
    PermitRootLogin yes
    PasswordAuthentication yes
    ChallengeResponseAuthentication yes
