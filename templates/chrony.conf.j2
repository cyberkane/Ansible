# Сгенерировано Ansible для хоста {{ inventory_hostname }} ({{ ansible_facts['distribution'] }})
server {{ ntp_server_ip }} iburst prefer

# Файл для хранения информации о дрейфе системных часов
driftfile {{ chrony_drift_file }}

# Разрешаем пошаговую корректировку времени при старте, если расхождение больше 1 секунды
makestep 1.0 3

# Синхронизация аппаратных часов (RTC)
rtcsync

# Директория для логов
logdir /var/log/chrony